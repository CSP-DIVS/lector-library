<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Selenium.Support" Version="4.35.0" />
    <PackageReference Include="Selenium.WebDriver" Version="4.35.0" />
    <PackageReference Include="Selenium.WebDriver.ChromeDriver" Version="140.0.7339.8200" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Configure automatic HTML test report generation -->
  <PropertyGroup>
    <VSTestResultsDirectory>$(MSBuildProjectDirectory)\TestResults</VSTestResultsDirectory>
    <VSTestLogger>html</VSTestLogger>
  </PropertyGroup>

  <!-- Ensure TestResults directory exists -->
  <Target Name="CreateTestResultsDirectory" BeforeTargets="VSTest">
    <MakeDir Directories="$(VSTestResultsDirectory)" Condition="!Exists('$(VSTestResultsDirectory)')" />
  </Target>

  <!-- Display test results location after tests complete -->
  <Target Name="ShowTestResultsLocation" AfterTargets="VSTest">
    <Message Text="HTML test results generated in: $(VSTestResultsDirectory)" Importance="high" />
    <Message Text="View the latest test report in your browser!" Importance="high" />
  </Target>

</Project>
