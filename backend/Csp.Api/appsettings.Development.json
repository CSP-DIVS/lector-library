{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server={DB_HOST};Database={DB_NAME};User={DB_USER};Password={DB_PASSWORD};Port={DB_PORT};SslMode=None;DefaultAuthenticationPlugin=mysql_native_password;AllowPublicKeyRetrieval=true"
  },
  "JwtSettings": {
    "SecretKey": "{JWT_SECRET_KEY}",
    "Issuer": "LmsApi",
    "Audience": "LmsClient",
    "ExpirationHours": 24
  },
  "Fines": {
    "DailyFineRate": 0.25,
    "IntervalHours": 24
  }
}